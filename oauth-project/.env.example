# .env.example — Safe to commit. Copy this to .env and fill in your values.
# Get these credentials from: https://console.cloud.google.com/ → APIs & Services → Credentials

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Callback URL — must match the Authorized Redirect URI set in Google Cloud Console
CALLBACK_URL=http://localhost:3000/auth/google/callback
